#!/bin/bash
# Stage 1 of fixing review comments on my PR: check out the PR branch (own worktree unless it's already
# checked out cleanly), let the agent (PR_AGENT) edit files there (uncommitted), then open the editor to review.
# Nothing is committed, pushed or replied here; that's pr-fix-finish.
# usage: pr-fix-prepare <pr-url> [--interactive]
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"   # $0 may be a symlink in ~/.local/bin
url=${1:?usage: pr-fix-prepare <pr-url> [--interactive]} mode_arg=${2:-}
pr_parts "$url"; use_gh_account; require_agent
title="PR fix · $repo #$num · $(agent_name)"

cache=$HOME/.cache/pr-fix; mkdir -p "$cache"
find "$cache" -maxdepth 1 -type f \( -name '*.log' -o -name '*.jsonl' \) -mtime +30 -delete 2>/dev/null
key=$repo-$num state=$cache/$key.json notes=$cache/$key.notes.json log=$cache/$key.log lock=$cache/$key.running
fail() { notify "$title" "$1"; echo "$1" >&2; exit 1; }

[[ -e $lock ]] && fail "Already running"
[[ -e $state ]] && fail "Fixes already prepared: finish or discard them first"
agent_name >"$lock"; trap 'rm -f "$lock"; refresh_menubar' EXIT
refresh_menubar

info=$(pr-threads "$url") || fail "Couldn't load the PR threads"
[[ $(jq -r .mine <<<"$info") == true ]] || fail "Not my PR"
[[ $(jq '.threads | length' <<<"$info") -gt 0 ]] || fail "No unresolved review comments"
branch=$(jq -r .headRefName <<<"$info")
clone=$(pr-review-repo-dir "$slug") || fail "No local clone of $slug found under ~ (clone it first)"
git -C "$clone" fetch origin "$branch" --quiet || fail "git fetch origin $branch failed"

# Where to work: the checkout that already has the branch (if clean), else a fresh worktree
checked_out=$(git -C "$clone" worktree list --porcelain |
  awk -v b="branch refs/heads/$branch" '/^worktree /{w=substr($0,10)} $0==b{print w}')
if [[ -n $checked_out ]]; then
  [[ -z $(git -C "$checked_out" status --porcelain) ]] || fail "$branch is checked out with uncommitted changes in $checked_out"
  git -C "$checked_out" merge --ff-only --quiet "origin/$branch" || fail "$branch in $checked_out has diverged from origin"
  dir=$checked_out mode=inplace
else
  if git -C "$clone" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null &&
     [[ -n $(git -C "$clone" rev-list "origin/$branch..$branch") ]]; then
    fail "Local $branch has unpushed commits; push or drop them first"
  fi
  dir=$cache/$key mode=worktree
  git -C "$clone" worktree add --quiet --track -B "$branch" "$dir" "origin/$branch" || fail "git worktree add failed"
fi
write_state() {   # the agent and its session are kept so pr-fix-followup can resume it with my feedback
  jq -n --arg url "$url" --arg repo "$repo" --arg num "$num" --arg dir "$dir" --arg mode "$mode" \
    --arg clone "$clone" --arg branch "$branch" --arg base "$(git -C "$dir" rev-parse HEAD)" \
    --arg agent "$PR_AGENT" --arg session "$1" \
    '{url: $url, repo: $repo, num: $num, dir: $dir, mode: $mode, clone: $clone, branch: $branch, base: $base,
      agent: $agent, session: $session}' >"$state"
}
cd "$dir" || fail "cd $dir failed"
prompt="$(skill pr-fix) $url --notes $notes"

if [[ $mode_arg == --interactive ]]; then
  # only Claude takes a session id up front; the others get a catch-up session on the first follow-up
  if [[ $PR_AGENT == claude ]]; then
    session=$(uuidgen | tr '[:upper:]' '[:lower:]'); cmd="claude --session-id $session $(printf %q "$prompt")"
  else
    session=; cmd=$(agent_cli "$prompt")
  fi
  write_state "$session"
  open_terminal "$dir" "$(gh_env_prefix)PR_FIX_URL='$url' $cmd"
  exit 0
fi

# Headless: file edits only inside this checkout + the notes file; read-only git.
write_state ""
PR_FIX_URL=$url agent_run fix "$prompt --headless" "${log%.log}"
write_state "$AGENT_SESSION"

status=$(grep -E '^STATUS:' "$log" | tail -1 | cut -c9-)
cost=$(sed -n 's/^COST: //p' "$log" | tail -1)
if [[ -z $status || ! -s $notes ]]; then
  notify "$title" "Failed. Click for the log." "file://$log"
elif [[ -n $(git status --porcelain) ]]; then
  open_editor "$dir"
  notify "$title" "$status: review the diff in your editor${cost:+ ($cost)}"
else
  notify "$title" "$status, no code changes. Details in the log." "file://$log"
fi
