#!/bin/bash
# Headless /pr-review: the agent (PR_AGENT) drafts the review in the background, then a notification
# (click → PR files tab). Its only write path is pr-review-post, pinned to this PR.
# usage: [PR_AGENT=claude|codex|agy] pr-review-headless <pr-url>
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"   # $0 may be a symlink in ~/.local/bin
url=${1:?usage: pr-review-headless <pr-url>}; pr_parts "$url"; use_gh_account; require_agent
title="PR review · $repo #$num · $(agent_name)"

state=$HOME/.cache/pr-review; mkdir -p "$state"
find "$state" -maxdepth 1 -type f \( -name '*.log' -o -name '*.jsonl' \) -mtime +30 -delete 2>/dev/null
log=$state/$repo-$num.log lock=$state/$repo-$num.running
[[ -e $lock ]] && { notify "$title" "Already running"; exit 0; }
agent_name >"$lock"; trap 'rm -f "$lock"; refresh_menubar' EXIT
refresh_menubar
notify "$title" "Reviewing in the background…"

# run inside the local clone so git history works
dir=$(pr-review-repo-dir "$slug") || dir=$HOME   # `cd ""` would silently stay put
cd "$dir"
PR_REVIEW_URL=$url agent_run review "$(skill pr-review) $url --headless" "${log%.log}"

status=$(grep -E '^STATUS:' "$log" | tail -1 | cut -c9-)
cost=$(sed -n 's/^COST: //p' "$log" | tail -1)
if [[ -n $status ]]; then
  notify "$title" "$status${cost:+ ($cost)}" "${url%/}/files"
else
  notify "$title" "Failed. Click for the log." "file://$log"
fi
